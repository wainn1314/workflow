# ===== Dify 工作流 API 配置 =====
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxx

# Dify 服务地址（末尾 /v1 可带可不带，程序会自动兼容）
# - Dify Cloud 云服务：https://api.dify.ai/v1
# - 自部署 Dify：例如 http://localhost
DIFY_BASE_URL=https://api.dify.ai/v1

DIFY_USER=prd-web-app

# ===== 本服务配置 =====
PORT=3000
