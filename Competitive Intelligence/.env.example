# ===== JSONBin 密钥配置 =====
# 用法：复制本文件为 .env 后填写真实值。
# 本文件（.env.example）会入库；真实的 .env 已被根级 .gitignore 忽略，绝不入库。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# Master Key 获取地址：https://jsonbin.io/app/account  （格式形如 $2a$10$xxxxxxxx...）

JSONBIN_API_KEY=REPLACE_WITH_YOUR_JSONBIN_MASTER_KEY
